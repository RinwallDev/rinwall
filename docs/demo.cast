{"version": 2, "width": 96, "height": 36, "timestamp": 1792906343, "title": "RinWall: zero-config in front of an MCP server", "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}}
[0.6, "o", "\u001b[2m# an MCP server is already running on :8000 - the one you want to put an agent in front of\u001b[0m\r\n"]
[1.0, "o", "\u001b[1;32m$\u001b[0m "]
[1.033, "o", "r"]
[1.059, "o", "i"]
[1.105, "o", "n"]
[1.128, "o", "w"]
[1.169, "o", "a"]
[1.204, "o", "l"]
