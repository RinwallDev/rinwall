[1.779, "o", "/"]
[1.822, "o", "/"]
[1.858, "o", "1"]
[1.917, "o", "2"]
[1.939, "o", "7"]
[1.993, "o", "."]
[2.025, "o", "0"]
[2.05, "o", "."]
[2.075, "o", "0"]
[2.107, "o", "."]
[2.16, "o", "1"]
[2.187, "o", ":"]
[2.231, "o", "8"]
[2.276, "o", "0"]
[2.311, "o", "0"]
[2.353, "o", "0"]
[2.375, "o", "/"]
[2.398, "o", "m"]
[2.426, "o", "c"]
[2.473, "o", "p"]
[2.823, "o", "\r\n"]
[2.868, "o", "\r\n"]
[2.913, "o", "  RinWall is running in front of http://127.0.0.1:8000/mcp\r\n"]
[2.958, "o", "  --------------------------------------------------------------------\r\n"]
[3.003, "o", "\r\n"]
[3.048, "o", "  Scanned 3 tools and classified them by what they can undo:\r\n"]
[3.093, "o", "\r\n"]
[3.138, "o", "     1 irreversible        needs a human to approve, every time\r\n"]
[3.183, "o", "         mcp_close_account\r\n"]
[3.228, "o", "     1 compensable         executes, and is undone automatically if the run fails\r\n"]
[3.273, "o", "         mcp_update_customer_tier\r\n"]
[3.318, "o", "     1 read-only/retryable executes freely\r\n"]
[3.363, "o", "\r\n"]
[3.408, "o", "  Point your agent at:   http://127.0.0.1:8080/mcp\r\n"]
[3.453, "o", "  Review pending calls:  http://127.0.0.1:8080/admin\r\n"]
[3.498, "o", "\r\n"]
[3.543, "o", "  To approve something, paste this reviewer token into that page:\r\n"]
[3.588, "o", "\r\n"]
[3.633, "o", "    eyJhbGciOiJIUzI1NiIsInR5cCI6...gyeI5g\r\n"]
[3.678, "o", "\r\n"]
[3.723, "o", "  Audit log: C:\\tmp\\rinwall\\audit.log\r\n"]
[3.768, "o", "  State:     C:\\tmp\\rinwall\\state.db\r\n"]
[3.813, "o", "\r\n"]
[3.858, "o", "  This is a getting-started mode. It is NOT hardened:\r\n"]
[3.903, "o", "    - no authentication (any request with no token is accepted as \"local\")\r\n"]
[3.948, "o", "    - no role policy (every role may attempt every tool)\r\n"]
[3.993, "o", "    - no Vault (the signing key is in memory and dies on restart)\r\n"]
[4.038, "o", "    - the catalog above is heuristic, not reviewed by anyone\r\n"]
[4.083, "o", "  Loopback only, for exactly those reasons.\r\n"]
[4.128, "o", "\r\n"]
[4.173, "o", "  To pin the catalog down and edit it:\r\n"]
[4.218, "o", "    go run ./cmd/blastradius --mcp http://127.0.0.1:8000/mcp --emit-registry > tools.yaml\r\n"]
[4.263, "o", "\r\n"]
[5.863, "o", "\r\n"]
